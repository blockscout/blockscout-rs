## Those are examples of existing configuration variables and their default values.
## When uncommented, they would overwrite corresponding values from `base.toml`
## configuration file.

#SMART_CONTRACT_VERIFIER__SERVER__HTTP__ENABLED=true
#SMART_CONTRACT_VERIFIER__SERVER__HTTP__ADDR=0.0.0.0:8050
#SMART_CONTRACT_VERIFIER__SERVER__HTTP__MAX_BODY_SIZE=2097152

#SMART_CONTRACT_VERIFIER__SERVER__GRPC__ENABLED=false
#SMART_CONTRACT_VERIFIER__SERVER__GRPC__ADDR=0.0.0.0:8051

#SMART_CONTRACT_VERIFIER__SOLIDITY__ENABLED=true
#SMART_CONTRACT_VERIFIER__SOLIDITY__COMPILERS_DIR=/tmp/solidity-compilers
#SMART_CONTRACT_VERIFIER__SOLIDITY__REFRESH_VERSIONS_SCHEDULE=0 0 * * * * *

## It depends on the OS you are running the service on
#SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__LIST__LIST_URL=https://binaries.soliditylang.org/linux-amd64/list.json
##SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__LIST__LIST_URL=https://binaries.soliditylang.org/macosx-amd64/list.json
##SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__LIST__LIST_URL=https://binaries.soliditylang.org/windows-amd64/list.json

##SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__S3__ACCESS_KEY=access_key
##SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__S3__SECRET_KEY=secret_key
##SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__S3__REGION=region
##SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__S3__ENDPOINT=endpoint
##SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__S3__BUCKET=bucket

#SMART_CONTRACT_VERIFIER__VYPER__ENABLED=true
#SMART_CONTRACT_VERIFIER__VYPER__COMPILERS_DIR=/tmp/vyper-compilers
#SMART_CONTRACT_VERIFIER__VYPER__REFRESH_VERSIONS_SCHEDULE=0 0 * * * * *

## It depends on the OS you are running the service on
#SMART_CONTRACT_VERIFIER__VYPER__FETCHER__LIST__LIST_URL=https://raw.githubusercontent.com/blockscout/solc-bin/main/vyper.list.json
##SMART_CONTRACT_VERIFIER__VYPER__FETCHER__LIST__LIST_URL=https://raw.githubusercontent.com/blockscout/solc-bin/main/vyper.macos.list.json

#SMART_CONTRACT_VERIFIER__SOURCIFY__ENABLED=true
#SMART_CONTRACT_VERIFIER__SOURCIFY__API_URL=https://sourcify.dev/server/
#SMART_CONTRACT_VERIFIER__SOURCIFY__VERIFICATION_ATTEMPTS=3
#SMART_CONTRACT_VERIFIER__SOURCIFY__REQUEST_TIMEOUT=15

#SMART_CONTRACT_VERIFIER__METRICS__ENABLED=false
#SMART_CONTRACT_VERIFIER__METRICS__ADDR=0.0.0.0:6060
#SMART_CONTRACT_VERIFIER__METRICS__ROUTE=/metrics

#SMART_CONTRACT_VERIFIER__JAEGER__ENABLED=false
#SMART_CONTRACT_VERIFIER__JAEGER__AGENT_ENDPOINT=localhost:6831

## Maximum concurrent compiler invocations, including version probes. In Docker mode this is the
## remote-job limit. If omitted, the number of CPU cores is used.
#SMART_CONTRACT_VERIFIER__COMPILERS__MAX_THREADS=8
## Native is intended only for local development. Production should use docker.
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__TYPE=native
## Applies to native and Docker execution. Benchmark representative viaIR workloads before tuning.
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__EXECUTION_TIMEOUT_SECONDS=600
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__MAX_OUTPUT_BYTES=268435456
## The remaining execution fields apply only to Docker mode.
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__ADDR=ssh://compiler-runner@example.org
## The target must already exist in /home/app/.ssh/known_hosts; TOFU is rejected.
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__KEY_PATH=/home/app/.ssh/id_ed25519
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__RUNNER_IMAGE=ghcr.io/blockscout/smart-contract-verifier-compiler-runner@sha256:...
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__PLATFORM=linux/amd64
## Bounds the lazy SSH host-key preflight independently from Docker API requests.
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__CONNECT_TIMEOUT_SECONDS=30
## Docker API request timeout; the effective value is at least EXECUTION_TIMEOUT_SECONDS so cold
## compiler-cache uploads retain the execution budget. Readiness checks use this value alone.
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__API_TIMEOUT_SECONDS=30
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__MEMORY_LIMIT_BYTES=1073741824
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__NANO_CPUS=2000000000
## Threads count toward this limit; zksolc starts a thread per host CPU plus a process per contract.
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__PIDS_LIMIT=1024
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__MAX_UPLOAD_BYTES=268435456
## Optional hardened runtime installed on the external Docker host, e.g. runsc.
#SMART_CONTRACT_VERIFIER__COMPILERS__EXECUTION__RUNTIME=runsc

#SMART_CONTRACT_VERIFIER__EXTENSIONS__SOLIDITY__SIG_PROVIDER__URL=http://127.0.0.1:8051/
#SMART_CONTRACT_VERIFIER__EXTENSIONS__VYPER__SIG_PROVIDER__URL=http://127.0.0.1:8051/
#SMART_CONTRACT_VERIFIER__EXTENSIONS__SOURCIFY__SIG_PROVIDER__URL=http://127.0.0.1:8051/
