{
  "permissions": {
    "allow": [
      "Bash(just test-with-db *)",
      "Bash(cargo test *)",
      "Bash(just check *)",
      "Bash(git grep *)",
      "Bash(just check-envs *)",
      "Bash(just --list*)",
      "Bash(cargo clippy -p *)",
      "Bash(just --show *)",
      "Bash(cargo fmt --all -- --check*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && exec graphify hook-guard search || exit 0"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && exec graphify hook-guard read || exit 0"
          }
        ]
      }
    ]
  }
}